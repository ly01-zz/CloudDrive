# ============================================================
# 云盘部署环境变量模板
# 使用方法：cp .env.example .env 并填入真实值（.env 已加入 .gitignore，不会提交）
# 生成随机密钥：openssl rand -hex 32
# ============================================================

# 数据库（docker mysql 容器）
DB_PASSWORD=change_me_mysql_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT 签名密钥（至少 32 字符随机串，泄露可伪造登录态！）
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# 腾讯云 COS 永久密钥（从腾讯云控制台 → 访问管理 → API密钥管理 获取）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=yunpan-1341779125
